# Supabase (local: copy values from `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used to build guest links
NEXT_PUBLIC_APP_URL=

# Comma-separated emails allowed to use the admin dashboard
ADMIN_EMAILS=

# EmailJS admin notifications (optional; skipped when empty)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
ADMIN_NOTIFICATION_EMAIL=
